#!/usr/bin/env python3
"""dnsbypass 启动器：不依赖 pip 安装，直接把项目目录塞进 sys.path。"""
import sys

sys.dont_write_bytecode = True  # root 跑出来的 __pycache__ 普通用户改不动，干脆不写
from pathlib import Path

ROOT = Path(__file__).resolve().parent
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from dnsbp.cli import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())